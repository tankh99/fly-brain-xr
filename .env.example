# Create a Meta Model API key at https://dev.meta.ai/ and keep it server-side.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
PORT=3001
# Separate MIT-licensed simulator checkout; its brain data has separate CC BY-NC terms.
FLY_SIMULATOR_ROOT=
# Defaults to $FLY_SIMULATOR_ROOT/.venv/bin/python
FLY_SIMULATOR_PYTHON=
